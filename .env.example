# MCP Server API Keys
# Copy this file to .env and fill in your keys

# Perplexity - Real-time web search and reasoning
# Get your key at: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your_perplexity_key_here

# Firecrawl - Web scraping, crawling, and extraction
# Get your key at: https://firecrawl.dev (free tier available)
FIRECRAWL_API_KEY=your_firecrawl_key_here

# Optional: Firecrawl custom endpoint (for self-hosted)
# FIRECRAWL_API_URL=https://api.firecrawl.dev

# Chrome MCP (chromecp) - No API key needed, but requires:
# 1. Chrome/Edge browser installed
# 2. Playwright Extension installed in browser: https://playwright.dev/docs/browsers#playwright-extension
# 3. Launch with --extension flag (see startup script)

# --- Outlook / Microsoft 365 Email (SMTP) ---
# 1. Enable 2FA on your Microsoft account
# 2. Go to Security → App passwords → Create new app password
# 3. Paste the app password below (NOT your login password)
OUTLOOK_SMTP_USER=your_email@outlook.com
OUTLOOK_SMTP_PASSWORD=your_app_password_here
OUTLOOK_SMTP_HOST=smtp.office365.com
OUTLOOK_SMTP_PORT=587