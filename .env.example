# OLP XDV Framework Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# =============================================================================
# DATABASE SETTINGS
# =============================================================================
DATABASE_URL=sqlite+aiosqlite:///./data/olpxdv.db
DATABASE_ECHO=false

# =============================================================================
# EXTERNAL API KEYS (Required for live data)
# =============================================================================
# The Odds API - Get key from https://the-odds-api.com/
ODDS_API_KEY=your_odds_api_key_here
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# API Football - Get key from https://www.api-football.com/
API_FOOTBALL_KEY=your_api_football_key_here
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# The Sports DB - Free tier available at https://www.thesportsdb.com/
SPORTS_DB_API_KEY=your_sports_db_key_here
SPORTS_DB_BASE_URL=https://www.thesportsdb.com/api/v1/json

# =============================================================================
# TELEGRAM BOT SETTINGS
# =============================================================================
# Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# =============================================================================
# SPORTYBET SETTINGS
# =============================================================================
SPORTYBET_USERNAME=your_sportybet_username
SPORTYBET_PASSWORD=your_sportybet_password
SPORTYBET_BASE_URL=https://www.sportybet.com

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
SECRET_KEY=your_very_long_random_secret_key_here_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# =============================================================================
# FRAMEWORK SETTINGS
# =============================================================================
CURRENT_PHASE=3
PAPER_ONLY=true
CLIENT_PUBLISH_ENABLED=false
CLV_MIN_LEGS=20
CLV_MEAN_THRESHOLD=0.02
MAX_KELLY_FRACTION=0.25
MAX_DAILY_EXPOSURE=100.0
MAX_SINGLE_BET_EXPOSURE=25.0
MIN_EDGE_FOR_PUBLISH=0.02

# =============================================================================
# PIPELINE TIMING (seconds)
# =============================================================================
SCAN_INTERVAL_SECONDS=300
TRIGGER_INTERVAL_SECONDS=60
PUBLISH_INTERVAL_SECONDS=120
VAULT_MEMORY_SYNC_INTERVAL_SECONDS=600

# =============================================================================
# DASHBOARD SETTINGS
# =============================================================================
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
DASHBOARD_RELOAD=false

# =============================================================================
# LOGGING SETTINGS
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=./logs/olpxdv.log
LOG_FORMAT=json

# =============================================================================
# OBSERVABILITY SETTINGS
# =============================================================================
METRICS_ENABLED=true
METRICS_PORT=9090
TRACING_ENABLED=false
TRACING_ENDPOINT=

# =============================================================================
# DESKTOP SETTINGS
# =============================================================================
DESKTOP_AUTO_START=true
DESKTOP_MINIMIZE_TO_TRAY=true
DESKTOP_SHOW_NOTIFICATIONS=true